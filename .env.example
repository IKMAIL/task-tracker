# Copy this file to .env and fill in values

# Shared secret for JWT signing — used by all services
JWT_SECRET=change-me-to-a-long-random-secret

# Shared token for service-to-service calls (X-Service-Token header)
SERVICE_TOKEN=change-me-to-another-long-random-secret

# MongoDB root credentials (used in docker-compose)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootpassword
