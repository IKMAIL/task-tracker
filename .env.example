# Copy this file to .env and fill in values

# Shared secret for JWT signing — used by all services
JWT_SECRET=change-me-to-a-long-random-secret

# Shared token for service-to-service calls (X-Service-Token header)
SERVICE_TOKEN=change-me-to-another-long-random-secret

# MongoDB root credentials (used in docker-compose)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootpassword

# Notification service MongoDB URI
NOTIFICATION_MONGO_URI=mongodb://localhost:27017/notifications

# Redis (shared by notification-service, alert-service, task-service, progress-service)
REDIS_URL=redis://localhost:6379
