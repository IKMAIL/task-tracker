{
  "mcpServers": {
    "task-tracker": {
      "command": "node",
      "args": ["services/mcp-server/dist/index.js"],
      "env": {
        "SERVICE_TOKEN": "<your-service-token>",
        "TASK_SERVICE_URL": "http://localhost:3002",
        "PROGRESS_SERVICE_URL": "http://localhost:3003",
        "ALERT_SERVICE_URL": "http://localhost:3004",
        "TEAM_SERVICE_URL": "http://localhost:3006"
      }
    }
  }
}
